# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cricket_auction?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h

# Comma separated list of allowed browser origins (dev + production)
CLIENT_URL=http://localhost:5173

# Use MongoDB multi-document transactions (requires replica set - Atlas always is one).
# Set to false ONLY for a local standalone mongod.
USE_TRANSACTIONS=true

# Initial admin created by `npm run seed`
ADMIN_NAME=Auction Admin
ADMIN_EMAIL=admin@auction.com
ADMIN_PASSWORD=Admin@123
